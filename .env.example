# Copy to .env and fill in for local development.
#
# Only VITE_-prefixed variables are exposed to the client bundle. Everything here is
# public by design -- the Supabase publishable (anon) key is safe to ship to browsers
# because row-level security is what actually restricts access.
#
# NEVER put the service role key in this file or any VITE_ variable. It bypasses RLS
# entirely. Service-role secrets belong in Supabase Edge Function secrets
# (`supabase secrets set`), where they stay server-side.

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
